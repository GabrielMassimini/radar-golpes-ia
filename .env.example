# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.

# Chaves dos provedores de LLM
# Gemini (padrão, camada gratuita): crie em aistudio.google.com
GEMINI_API_KEY=
# Opcionais
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Modelo padrão do detector (confirmado na Fase 2)
RADAR_MODELO=gemini-3.5-flash-lite

# Segredo que o n8n manda no header X-Radar-Token (sem limite de uso)
RADAR_TOKEN=

# Análises por hora por IP na página pública
RADAR_LIMITE_DEMO=15

# Opcional: US$ por milhão de tokens, para calcular custo dos modelos OpenAI nos evals
OPENAI_PRECO_INPUT=
OPENAI_PRECO_OUTPUT=

# Bot do Telegram (Fase 7): cópia de segurança do token do @BotFather.
# O n8n usa a credencial dele, cadastrada no próprio n8n.
TELEGRAM_BOT_TOKEN=