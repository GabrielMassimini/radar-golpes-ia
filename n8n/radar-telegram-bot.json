    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "=Olá! Eu sou o Radar de Golpes 🔎\n\nMe mande o texto de uma mensagem, anúncio ou e-mail suspeito, ou um print, e eu digo o risco de ser golpe e por quê.\n\nNão envie dados pessoais (CPF, senhas, número de cartão).\n\nO Radar é uma ferramenta de apoio e pode errar. A decisão é sua.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        448,
        -256
      ],
      "id": "261c8ff4-e792-406c-b2d5-dcaf661f5af4",
      "name": "Boas-vindas",
      "webhookId": "9a7e8e58-54ad-4801-bbf5-8647cbb3bec1",
      "credentials": {
        "telegramApi": {
          "id": "0hKTjAkyOdnkE2OM",
          "name": "Token Telegram"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pega o texto da mensagem e corta no limite da API (6.000 caracteres).\nconst mensagem = $('Telegram Trigger').first().json.message;\nconst texto = (mensagem.text || mensagem.caption || '').trim().slice(0, 6000);\nreturn [{ json: { texto } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "id": "b7c4ff75-fefe-43d6-8e0c-44ea654cafd0",
      "name": "Preparar texto"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://radar-golpes-ia.vercel.app/api/analisar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        96
      ],
      "id": "79e05be6-0d2f-483d-8285-1e324caf2045",
      "name": "Analisar na API",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "stivWrMX0HCNKZfT",
          "name": "Token Radar API"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Monta a resposta do Telegram (HTML) a partir da análise da API.\nconst NIVEIS = { baixo: '🟢 Risco baixo', medio: '🟡 Risco médio', alto: '🔴 Risco alto' };\nconst CATEGORIAS = {\n  pagamento_antecipado: 'Pedido de pagamento adiantado',\n  comprovante_falso: 'Comprovante ou pagamento falso',\n  falso_intermediario: 'Falso intermediário ou entregador',\n  phishing_link: 'Link falso para roubar dados',\n  falso_parente_ou_conhecido: 'Falso parente ou conhecido',\n  falso_suporte_ou_banco: 'Falso banco ou suporte',\n  falsa_venda_preco_baixo: 'Venda falsa com preço baixo',\n  falso_aluguel_imovel: 'Aluguel falso',\n  falsa_vaga_emprego: 'Vaga de emprego falsa',\n  investimento_falso: 'Investimento falso',\n  premio_ou_restituicao_falsa: 'Prêmio ou restituição falsa',\n  outro_golpe: 'Outro tipo de golpe',\n  nenhum: 'Nenhum golpe identificado',\n};\n\n// O Telegram lê a resposta como HTML: <, > e & do conteúdo viram texto comum.\nconst escapar = (t) => String(t ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst cortar = (t, max) => (t.length > max ? t.slice(0, max - 1) + '…' : t);\n\nconst a = $input.first().json.analise;\nconst linhas = [\n  `<b>${NIVEIS[a.nivel_risco] || escapar(a.nivel_risco)} (${a.pontuacao}/100)</b>`,\n  escapar(CATEGORIAS[a.categoria] || a.categoria),\n  '',\n  escapar(a.explicacao),\n];\n\nconst sinais = (a.sinais || []).slice(0, 4);\nif (sinais.length) {\n  linhas.push('', a.nivel_risco === 'baixo' ? '<b>Trechos que indicam segurança</b>' : '<b>Sinais encontrados</b>');\n  for (const s of sinais) {\n    linhas.push(`• ${escapar(s.sinal)}: <i>\"${escapar(cortar(String(s.trecho), 200))}\"</i>`);\n  }\n}\n\nlinhas.push('', '<b>O que fazer</b>', escapar(a.recomendacao));\nlinhas.push('', '<i>O Radar é uma ferramenta de apoio e pode errar. A decisão é sua.</i>');\nreturn [{ json: { resposta: linhas.join('\\n') } }];"
      },
