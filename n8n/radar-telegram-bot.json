    {
      "parameters": {
        "jsCode": "// Converte o print baixado do Telegram em base64, o formato que a API recebe.\n// A legenda da foto, se houver, vai junto como texto.\nconst mensagem = $('Telegram Trigger').first().json.message;\nconst imagem = await this.helpers.getBinaryDataBuffer(0, 'data');\nreturn [{\n  json: {\n    texto: (mensagem.caption || '').trim().slice(0, 6000),\n    imagem_base64: imagem.toString('base64'),\n    imagem_media_type: 'image/jpeg', // o Telegram sempre converte fotos para JPEG\n  },\n}];"
      },
